rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function liarRoomPath(appId, roomId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/uno_rooms/$(roomId);
    }

    function isLiarRoomMember(appId, roomId) {
      let room = get(liarRoomPath(appId, roomId)).data;
      return isSignedIn()
        && room.gameType == 'liar3d'
        && room.memberUids is list
        && room.memberUids.hasAny([request.auth.uid]);
    }

    function isLiarRoomHost(appId, roomId) {
      let room = get(liarRoomPath(appId, roomId)).data;
      return isSignedIn()
        && room.gameType == 'liar3d'
        && room.hostId == request.auth.uid;
    }

    function validLiarMemberData(uid) {
      return request.resource.data.keys().hasOnly(['uid', 'name', 'avatar', 'joinedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 16
        && request.resource.data.name.matches('^[^<>]*$')
        && request.resource.data.avatar == '😎'
        && request.resource.data.joinedAt is number;
    }

    function isPokerRoomMember(appId, roomId, uid) {
      let room = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/uno_rooms/$(roomId)).data;
      return isSignedIn() && room.arcadeMode == 'poker' && room.memberUids is list && room.memberUids.hasAny([uid]);
    }

    // SALAS UNO, TCG Y ARCADE.
    match /artifacts/{appId}/public/data/uno_rooms/{roomId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.arcadeMode != 'poker'
        && (
          request.resource.data.code == roomId
          || roomId == 'TCG-' + request.resource.data.code
        );

      // En Mentiroso 3D el anfitrión es la autoridad de la partida.
      // Los invitados solo pueden reservar/liberar su propio asiento mientras espera la sala.
      allow update: if isSignedIn()
        && resource.data.arcadeMode != 'poker'
        && request.resource.data.hostId == resource.data.hostId
        && (
          resource.data.gameType == 'liar3d'
            ? (
                resource.data.hostId == request.auth.uid
                || (
                  resource.data.status == 'waiting'
                  && resource.data.memberUids is list
                  && request.resource.data.memberUids is list
                  && request.resource.data.updatedAt is number
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                  && (
                    (
                      !resource.data.memberUids.hasAny([request.auth.uid])
                      && request.resource.data.memberUids.hasAll(resource.data.memberUids)
                      && request.resource.data.memberUids.hasAny([request.auth.uid])
                      && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
                      && request.resource.data.memberUids.size() <= 6
                    )
                    || (
                      resource.data.memberUids.hasAny([request.auth.uid])
                      && !request.resource.data.memberUids.hasAny([request.auth.uid])
                      && resource.data.memberUids.hasAll(request.resource.data.memberUids)
                      && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
                    )
                  )
                )
              )
            : true
        );

      allow delete: if isSignedIn()
        && resource.data.arcadeMode != 'poker'
        && resource.data.hostId == request.auth.uid;
    }

    // MIEMBROS DEL LOBBY.
    // Cada UID solo puede registrar y modificar su propio perfil de sala.
    match /artifacts/{appId}/public/data/uno_liar_private/{roomId}/members/{uid} {
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && validLiarMemberData(uid)
        && get(liarRoomPath(appId, roomId)).data.gameType == 'liar3d'
        && get(liarRoomPath(appId, roomId)).data.status == 'waiting'
        && get(liarRoomPath(appId, roomId)).data.memberUids is list
        && get(liarRoomPath(appId, roomId)).data.memberUids.size() < 6;

      allow read: if isSignedIn()
        && (request.auth.uid == uid || isLiarRoomHost(appId, roomId));

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && validLiarMemberData(uid)
        && get(liarRoomPath(appId, roomId)).data.status == 'waiting';

      allow delete: if isLiarRoomHost(appId, roomId)
        || (
          isSignedIn()
          && request.auth.uid == uid
          && get(liarRoomPath(appId, roomId)).data.status in ['waiting', 'closed']
        );
    }

    // MANOS PRIVADAS.
    // Solo el dueño puede leer su mano. El anfitrión distribuye/actualiza las cartas.
    match /artifacts/{appId}/public/data/uno_liar_private/{roomId}/hands/{uid} {
      allow read: if isSignedIn()
        && request.auth.uid == uid
        && isLiarRoomMember(appId, roomId);

      allow create, update: if isLiarRoomHost(appId, roomId)
        && request.resource.data.keys().hasOnly(['uid', 'cards', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.cards is list
        && request.resource.data.cards.size() <= 5
        && request.resource.data.updatedAt is number;

      allow delete: if isLiarRoomHost(appId, roomId);
    }

    // ACCIONES DE PARTIDA.
    // Los invitados solo pueden enviar una acción en su turno.
    // El anfitrión valida las cartas y ejecuta el motor original.
    match /artifacts/{appId}/public/data/uno_liar_actions/{roomId}/actions/{actionId} {
      allow read: if isLiarRoomMember(appId, roomId);

      allow create: if isLiarRoomMember(appId, roomId)
        && request.resource.data.keys().hasOnly(['actorUid', 'type', 'createdAt', 'cardIds'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.type in ['play', 'challenge', 'next_round']
        && request.resource.data.createdAt is number
        && get(liarRoomPath(appId, roomId)).data.status == 'playing'
        && get(liarRoomPath(appId, roomId)).data.gameState.turnUid == request.auth.uid
        && (
          request.resource.data.type == 'play'
            ? get(liarRoomPath(appId, roomId)).data.gameState.phase == 'TURN'
              && request.resource.data.cardIds is list
              && request.resource.data.cardIds.size() >= 1
              && request.resource.data.cardIds.size() <= 3
              && request.resource.data.cardIds[0] is string
              && (
                request.resource.data.cardIds.size() < 2
                || request.resource.data.cardIds[1] is string
              )
              && (
                request.resource.data.cardIds.size() < 3
                || request.resource.data.cardIds[2] is string
              )
            : request.resource.data.type == 'challenge'
              ? get(liarRoomPath(appId, roomId)).data.gameState.phase == 'TURN'
                && get(liarRoomPath(appId, roomId)).data.gameState.lastClaim != null
                && get(liarRoomPath(appId, roomId)).data.gameState.lastClaim.playerUid != request.auth.uid
              : get(liarRoomPath(appId, roomId)).data.gameState.phase == 'ROUND_END'
        );

      allow update, delete: if isLiarRoomHost(appId, roomId);
    }


    // MANOS DE UNO HOLD'EM: cada jugador solo puede leer sus propias cartas.
    // Las escrituras se realizan exclusivamente desde Cloud Functions (Admin SDK).
    match /artifacts/{appId}/public/data/uno_poker_private/{roomId}/hands/{uid} {
      allow read: if isSignedIn()
        && request.auth.uid == uid
        && isPokerRoomMember(appId, roomId, uid);
      allow create, update, delete: if false;
    }


    // Mazo no repartido: solo Cloud Functions puede leerlo o modificarlo.
    match /artifacts/{appId}/public/data/uno_poker_private/{roomId}/server/{stateId} {
      allow read, write: if false;
    }

    // LEADERBOARD GLOBAL UNO! CLUB.
    match /artifacts/{appId}/public/data/uno_leaderboard/{userId} {
      allow read: if true;

      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.name is string
        && request.resource.data.matches is number
        && request.resource.data.wins is number;

      allow delete: if false;
    }

    // NOMBRES DE USUARIO ÚNICOS.
    match /artifacts/{appId}/public/data/uno_usernames/{usernameId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.normalized == usernameId;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.normalized == usernameId;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // PERFILES Y PROGRESO SINCRONIZADOS.
    match /artifacts/{appId}/users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // El saldo de Póker solo puede cambiarlo Cloud Functions.
      allow create: if isSignedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['pokerChips']);
      allow update: if isSignedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pokerChips']);
      allow delete: if false;
    }
  }
}